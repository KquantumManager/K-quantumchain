<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<script>
  (function(){
    var saved = localStorage.getItem('winspire-theme');
    var isMain = (window.location.pathname === '/' || window.location.pathname === '' || window.location.pathname === '/index');
    var defaultTheme = isMain ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', (saved === 'light' || saved === 'dark') ? saved : defaultTheme);
    var lang = localStorage.getItem('kquantum-lang');
    document.documentElement.setAttribute('lang', (lang === 'en' ? 'en' : 'ko'));
  })();
</script>
<title>K-Quantum Holdings - <%= title %></title>
