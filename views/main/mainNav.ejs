<script>
  (function(){
    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('winspire-theme', theme);
      var isLight = (theme === 'light');
      var s1 = document.getElementById('themeSwitch');
      var s2 = document.getElementById('themeSwitchMobile');
      if (s1) s1.checked = isLight;
      if (s2) s2.checked = isLight;
    }
    // 메인(/) = 다크 기본, 서브 = 라이트 기본
    var saved = localStorage.getItem('winspire-theme');
    var isMain = (window.location.pathname === '/' || window.location.pathname === '' || window.location.pathname === '/index');
    var defaultTheme = isMain ? 'dark' : 'light';
    setTheme((saved === 'light' || saved === 'dark') ? saved : defaultTheme);

    ['themeSwitch', 'themeSwitchMobile'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) {
        el.checked = (document.documentElement.getAttribute('data-theme') === 'light');
        el.addEventListener('change', function() { setTheme(this.checked ? 'light' : 'dark'); });
      }
    });

    function setLang(lang) {
      document.documentElement.setAttribute('lang', lang);
      localStorage.setItem('kquantum-lang', lang);
      var koBtns = document.querySelectorAll('#langKo, #langKoMobile');
      var enBtns = document.querySelectorAll('#langEn, #langEnMobile');
      koBtns.forEach(function(b) { b.classList.toggle('active', lang === 'ko'); });
      enBtns.forEach(function(b) { b.classList.toggle('active', lang === 'en'); });
    }
    var savedLang = localStorage.getItem('kquantum-lang');
    setLang(savedLang === 'en' ? 'en' : 'ko');
    document.querySelectorAll('#langKo, #langKoMobile').forEach(function(el) {
      if (el) el.addEventListener('click', function() { setLang('ko'); });
    });
    document.querySelectorAll('#langEn, #langEnMobile').forEach(function(el) {
      if (el) el.addEventListener('click', function() { setLang('en'); });
    });

    // Close offcanvas when a section anchor link is clicked
    var offcanvas = document.getElementById('offcanvasNavbar');
    var sectionLinks = document.querySelectorAll('.nav-section-link');
    sectionLinks.forEach(function(a) {
      a.addEventListener('click', function() {
        if (offcanvas && window.bootstrap && bootstrap.Offcanvas.getInstance(offcanvas)) {
          bootstrap.Offcanvas.getInstance(offcanvas).hide();
        }
      });
    });
  })();
</script>
