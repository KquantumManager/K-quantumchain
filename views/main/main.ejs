<!DOCTYPE html>
<html lang="ko">
  <head>
    <%- include("head.ejs", { title: "K-Quantum Holdings – Quantum Chain" }) %>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        word-break: keep-all;
      }

      :root,
      [data-theme="dark"] {
        --navy: #050508;
        --navy-mid: #0c0c12;
        --navy-light: #14141c;
        --accent: #2E86FF;
        --accent-light: #66B2FF;
        --accent-dark: #1B6AFE;
        --accent-muted: rgba(46, 134, 255, 0.12);
        --accent-glow: rgba(46, 134, 255, 0.28);
        --deep-blue: #1e3a5f;
        --text-primary: #ffffff;
        --text-secondary: #94a3b8;
        --bg-white: #050508;
        --bg-off: #0c0c12;
        --border: rgba(148, 163, 184, 0.15);
      }

      [data-theme="light"] {
        --navy: #050508;
        --navy-mid: #0c0c12;
        --accent: #007BFF;
        --accent-light: #3399FF;
        --accent-dark: #0056B3;
        --accent-muted: rgba(0, 123, 255, 0.08);
        --accent-glow: rgba(0, 123, 255, 0.18);
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --bg-white: #ffffff;
        --bg-off: #f8fafc;
        --border: #e2e8f0;
      }

      html { scroll-behavior: smooth; }
      body {
        position: relative;
        background: var(--bg-white);
        font-family: "Inter", -apple-system, sans-serif;
        color: var(--text-primary);
        line-height: 1.6;
        min-height: 100vh;
        overflow-x: hidden;
        transition: background 0.25s ease, color 0.25s ease;
      }

      [data-theme="dark"] body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background: radial-gradient(
          ellipse 120% 80% at 30% 100%,
          rgba(46, 134, 255, 0.12) 0%,
          rgba(30, 58, 95, 0.2) 40%,
          transparent 70%
        ), radial-gradient(
          ellipse 80% 60% at 70% 100%,
          rgba(30, 58, 95, 0.25) 0%,
          transparent 60%
        );
      }

      .content-wrapper {
        position: relative;
        z-index: 1;
      }

      nav {
        position: sticky !important;
        top: 0 !important;
        z-index: 1000 !important;
      }

      /* ——— 상단 이슈 마키 (특허 획득) ——— */
      .hero-marquee {
        position: relative;
        z-index: 999;
        background: linear-gradient(90deg, var(--navy-mid) 0%, var(--accent-dark) 35%, var(--accent) 50%, var(--accent-dark) 65%, var(--navy-mid) 100%);
        border-bottom: 2px solid var(--accent);
        padding: 12px 0;
        overflow: hidden;
        white-space: nowrap;
      }
      .hero-marquee-inner {
        display: inline-flex;
        align-items: center;
        gap: 2em;
        animation: hero-marquee-scroll 28s linear infinite;
      }
      .hero-marquee span {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-shadow: 0 0 20px rgba(255,255,255,0.3);
      }
      @keyframes hero-marquee-scroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      .section {
        padding: 80px clamp(20px, 5vw, 40px);
        max-width: 1000px;
        margin: 0 auto;
        width: 100%;
      }

      @media (max-width: 768px) {
        .section {
          padding-left: 20px;
          padding-right: 20px;
        }
      }

      .section-title {
        font-size: clamp(24px, 4vw, 32px);
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 12px;
        letter-spacing: -0.02em;
      }

      .section-subtitle {
        font-size: 15px;
        color: var(--text-secondary);
        line-height: 1.7;
        max-width: 640px;
      }

      /* ——— HERO ——— */
      .hero {
        position: relative;
        padding: 140px clamp(24px, 6vw, 48px) 140px;
        text-align: left;
        max-width: 920px;
        margin: 0 auto;
        min-height: 60vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
      }
      .hero-gradient-orb {
        position: absolute;
        pointer-events: none;
        border-radius: 50%;
        z-index: 0;
      }
      .hero-gradient-orb--1 {
        width: min(80vw, 520px);
        height: min(80vw, 520px);
        top: -15%;
        right: -18%;
        background: radial-gradient(circle at 40% 40%, rgba(46, 134, 255, 0.42) 0%, rgba(30, 58, 95, 0.28) 45%, transparent 70%);
        animation: hero-orb-drift 8s ease-in-out infinite;
      }
      .hero-gradient-orb--2 {
        width: min(60vw, 380px);
        height: min(60vw, 380px);
        bottom: -20%;
        left: -12%;
        background: radial-gradient(circle at 60% 60%, rgba(0, 180, 170, 0.35) 0%, rgba(13, 148, 136, 0.2) 50%, transparent 72%);
        animation: hero-orb-drift 10s ease-in-out infinite reverse;
        animation-delay: -2s;
      }
      .hero-gradient-orb--3 {
        width: min(45vw, 280px);
        height: min(45vw, 280px);
        top: 50%;
        left: 30%;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle at 50% 50%, rgba(102, 178, 255, 0.28) 0%, rgba(46, 134, 255, 0.12) 50%, transparent 65%);
        animation: hero-orb-float 6s ease-in-out infinite;
      }
      [data-theme="light"] .hero-gradient-orb--1 {
        background: radial-gradient(circle at 40% 40%, rgba(0, 123, 255, 0.28) 0%, rgba(0, 86, 179, 0.16) 45%, transparent 70%);
      }
      [data-theme="light"] .hero-gradient-orb--2 {
        background: radial-gradient(circle at 60% 60%, rgba(0, 150, 140, 0.22) 0%, rgba(13, 128, 118, 0.12) 50%, transparent 72%);
      }
      [data-theme="light"] .hero-gradient-orb--3 {
        background: radial-gradient(circle at 50% 50%, rgba(51, 153, 255, 0.2) 0%, rgba(0, 123, 255, 0.08) 50%, transparent 65%);
      }
      @keyframes hero-orb-drift {
        0%, 100% { transform: translate(0, 0) scale(1); opacity: 1; }
        25% { transform: translate(20px, -25px) scale(1.08); opacity: 0.95; }
        50% { transform: translate(-15px, 15px) scale(0.96); opacity: 1; }
        75% { transform: translate(10px, 20px) scale(1.04); opacity: 0.98; }
      }
      @keyframes hero-orb-float {
        0%, 100% { transform: translate(-50%, -50%) scale(1); }
        50% { transform: translate(-50%, -50%) scale(1.15); }
      }
      .hero .hero-tagline,
      .hero .hero-subtext { position: relative; z-index: 1; }

      @media (max-width: 768px) {
        .hero {
          padding: 100px 20px 100px;
          min-height: 50vh;
          text-align: center;
          align-items: center;
        }
        .hero-subtext { max-width: none; }
      }

      .hero::before {
        content: "";
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 4px;
        height: 120px;
        background: linear-gradient(180deg, transparent, var(--accent), transparent);
        border-radius: 2px;
        opacity: 0.8;
      }

      @media (max-width: 768px) {
        .hero::before { left: 50%; top: auto; bottom: 24px; transform: translateX(-50%); width: 80px; height: 4px; background: linear-gradient(90deg, transparent, var(--accent), transparent); }
      }

      .hero-tagline {
        font-size: 13px;
        font-weight: 700;
        color: var(--accent);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        margin-bottom: 20px;
        opacity: 0.95;
      }

      .hero-subtext {
        font-size: clamp(36px, 6vw, 56px);
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.2;
        letter-spacing: -0.04em;
        margin-bottom: 0;
        max-width: 14ch;
      }

      .hero-subtext .hero-accent {
        display: block;
        margin-top: 0.15em;
        background: linear-gradient(135deg, var(--accent-dark) 0%, var(--accent-light) 50%, var(--accent) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      [data-theme="light"] .hero-subtext .hero-accent {
        background: linear-gradient(135deg, var(--accent-dark) 0%, var(--accent) 50%, var(--accent-light) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .hero-cta {
        margin-top: 48px;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 15px;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
        transition: opacity 0.25s ease, gap 0.25s ease;
      }

      .hero-cta:hover { opacity: 0.9; gap: 16px; color: var(--accent); }
      .hero-cta i { font-size: 14px; transition: transform 0.3s ease; }
      .hero-cta:hover i { transform: translateX(4px); }

      /* ——— 기술 패러다임 (미드 히어로) ——— */
      .paradigm-hero {
        padding: 100px 24px;
        margin: 0;
        max-width: none;
        background: var(--bg-off);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        position: relative;
        overflow: hidden;
      }

      .paradigm-hero::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, var(--accent), rgba(46, 134, 255, 0.4));
        opacity: 0.9;
      }

      [data-theme="dark"] .paradigm-hero::after {
        content: "";
        position: absolute;
        right: -10%;
        top: 50%;
        transform: translateY(-50%);
        width: 40%;
        height: 80%;
        background: radial-gradient(ellipse at center, rgba(46, 134, 255, 0.06) 0%, transparent 70%);
        pointer-events: none;
      }

      .paradigm-hero-inner {
        max-width: 720px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
      }

      .paradigm-hero .paradigm-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--accent);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin-bottom: 16px;
      }

      .paradigm-hero .paradigm-title {
        font-size: clamp(26px, 4.5vw, 34px);
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.3;
        letter-spacing: -0.03em;
        margin-bottom: 12px;
      }

      .paradigm-hero .paradigm-title-sub {
        font-size: clamp(18px, 3.2vw, 22px);
        font-weight: 600;
        color: var(--text-secondary);
        line-height: 1.5;
        letter-spacing: -0.02em;
        margin-bottom: 24px;
      }

      .paradigm-hero .paradigm-sub {
        font-size: 16px;
        color: var(--text-secondary);
        line-height: 1.7;
        margin-bottom: 28px;
      }

      .paradigm-hero .paradigm-quote {
        padding: 20px 24px;
        border-left: 3px solid var(--accent);
        background: rgba(46, 134, 255, 0.06);
        border-radius: 0 10px 10px 0;
        font-size: 15px;
        color: var(--text-primary);
        line-height: 1.65;
        font-weight: 500;
      }

      .paradigm-hero .paradigm-quote strong { color: var(--accent); }
      [data-theme="light"] .paradigm-hero .paradigm-quote { background: rgba(13, 148, 136, 0.06); }

      /* ——— WHO WE ARE ——— */
      .intro-body {
        font-size: 16px;
        color: var(--text-secondary);
        line-height: 1.75;
        max-width: 640px;
      }

      /* ——— WHAT WE OPERATE ——— */
      .ops-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-top: 48px;
      }
      .ops-grid-2col { grid-template-columns: repeat(2, 1fr); }
      @media (max-width: 900px) {
        .ops-grid { grid-template-columns: 1fr; }
        .ops-grid-2col { grid-template-columns: 1fr; }
      }
      .ops-card {
        position: relative;
        background: var(--bg-off);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 28px 26px 26px;
        transition: border-color 0.25s ease, transform 0.35s ease, box-shadow 0.35s ease;
        overflow: hidden;
      }
      .ops-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--accent), rgba(46, 134, 255, 0.4));
        opacity: 0.85;
      }
      .ops-card:hover {
        border-color: var(--accent-glow);
        box-shadow: 0 20px 40px -12px rgba(46, 134, 255, 0.15);
      }
      [data-theme="dark"] .ops-card:hover {
        box-shadow: 0 20px 48px -12px rgba(0,0,0,0.4), 0 0 0 1px rgba(46, 134, 255, 0.2);
      }
      .ops-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(46, 134, 255, 0.2), rgba(46, 134, 255, 0.06));
        border: 1px solid rgba(46, 134, 255, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 20px;
        color: var(--accent);
      }
      .ops-card .ops-tag {
        font-size: 11px;
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .ops-card h3 {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 14px;
        letter-spacing: -0.02em;
        line-height: 1.3;
      }
      .ops-card-logo { margin-bottom: 16px; line-height: 0; }
      .ops-card-logo img {
        max-width: 140px; height: auto; max-height: 48px;
        object-fit: contain; display: block;
      }
      [data-theme="light"] .ops-card-logo img { filter: none; }
      .ops-card ul { list-style: none; margin-bottom: 16px; }
      .ops-card ul li {
        position: relative;
        padding-left: 18px;
        margin-bottom: 10px;
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
      }
      .ops-card ul li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 9px;
        width: 5px;
        height: 5px;
        background: var(--accent);
        border-radius: 50%;
        box-shadow: 0 0 10px rgba(46, 134, 255, 0.4);
      }
      .ops-card .ops-note {
        font-size: 12px;
        color: var(--text-secondary);
        font-style: italic;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
        line-height: 1.55;
      }

      /* ——— LICENSING & COMPLIANCE ——— */
      .compliance-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
        margin-top: 44px;
      }
      @media (max-width: 640px) {
        .compliance-grid { grid-template-columns: 1fr; }
      }
      .compliance-box {
        position: relative;
        background: var(--bg-off);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 28px 26px;
        transition: border-color 0.25s ease, transform 0.35s ease, box-shadow 0.35s ease;
        overflow: hidden;
      }
      .compliance-box::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 80px;
        height: 80px;
        background: radial-gradient(circle at 100% 0%, rgba(46, 134, 255, 0.08) 0%, transparent 70%);
        pointer-events: none;
      }
      .compliance-box h4 {
        font-size: 17px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .compliance-box .compliance-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(46, 134, 255, 0.18), rgba(46, 134, 255, 0.06));
        border: 1px solid rgba(46, 134, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: var(--accent);
      }
      .compliance-box .status-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        padding: 10px 14px;
        background: rgba(46, 134, 255, 0.06);
        border: 1px solid var(--border);
        border-radius: 10px;
      }
      .compliance-box .status-label {
        font-size: 13px;
        color: var(--text-secondary);
      }
      .compliance-box .status-value {
        font-size: 12px;
        font-weight: 700;
        color: var(--accent);
        letter-spacing: 0.03em;
      }
      .compliance-box ul { list-style: none; }
      .compliance-box ul li {
        position: relative;
        padding-left: 18px;
        margin-bottom: 10px;
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
      }
      .compliance-box ul li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 9px;
        width: 5px;
        height: 5px;
        background: var(--accent);
        border-radius: 50%;
      }

      /* ——— ECOSYSTEM ——— */
      .ecosystem-body {
        font-size: 15px;
        color: var(--text-secondary);
        line-height: 1.75;
        max-width: 640px;
        margin-top: 16px;
      }

      /* ——— WHY PARTNER ——— */
      .partner-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-top: 32px;
      }

      @media (max-width: 600px) {
        .partner-grid {
          grid-template-columns: 1fr;
        }
      }

      .partner-box {
        background: var(--bg-off);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 24px;
      }

      .partner-box h4 {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 8px;
      }

      .partner-box p {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
      }

      .partner-audience {
        margin-top: 24px;
        font-size: 13px;
        color: var(--text-secondary);
      }

      .partner-audience strong {
        color: var(--text-primary);
      }

      /* ——— OUR APPS (Q-Stable, Quantum-OTP, QwonPAY) ——— */
      .apps-intro { font-size: 15px; color: var(--text-secondary); margin-bottom: 40px; max-width: 720px; line-height: 1.75; }
      .app-card { background: var(--bg-off); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; margin-bottom: 40px; display: grid; grid-template-columns: 1fr 1.2fr; gap: 0; align-items: stretch; }
      @media (max-width: 900px) { .app-card { grid-template-columns: 1fr; } }
      .app-card.app-card--reverse { direction: rtl; }
      .app-card.app-card--reverse > * { direction: ltr; }
      .app-card-image {
        position: relative;
        min-height: 280px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(0,0,0,0.03);
      }
      [data-theme="dark"] .app-card-image { background: rgba(0,0,0,0.2); }
      .app-card-image::before {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 20px;
        width: 60%;
        height: 16px;
        transform: translateX(-50%);
        background: radial-gradient(ellipse at center, rgba(0,0,0,0.25) 0%, transparent 70%);
        filter: blur(8px);
        border-radius: 50%;
        z-index: 0;
      }
      [data-theme="dark"] .app-card-image::before {
        background: radial-gradient(ellipse at center, rgba(0,0,0,0.5) 0%, transparent 70%);
      }
      .app-card-image img {
        position: relative;
        z-index: 1;
        max-width: 100%;
        max-height: 320px;
        width: auto;
        height: auto;
        object-fit: contain;
        border-radius: 12px;
        filter: drop-shadow(0 8px 16px rgba(0,0,0,0.15)) drop-shadow(0 24px 40px rgba(0,0,0,0.2)) drop-shadow(0 4px 20px rgba(46, 134, 255, 0.12));
        animation: app-card-float 3.2s ease-in-out infinite;
      }
      [data-theme="dark"] .app-card-image img {
        filter: drop-shadow(0 10px 24px rgba(0,0,0,0.45)) drop-shadow(0 28px 48px rgba(0,0,0,0.35)) drop-shadow(0 8px 28px rgba(46, 134, 255, 0.15));
      }
      @keyframes app-card-float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-16px); }
      }
      .reveal-stagger .app-card:nth-child(1) .app-card-image img { animation-delay: 0s; }
      .reveal-stagger .app-card:nth-child(2) .app-card-image img { animation-delay: 0.7s; }
      .reveal-stagger .app-card:nth-child(3) .app-card-image img { animation-delay: 1.4s; }
      .app-card-body { padding: 32px; display: flex; flex-direction: column; justify-content: center; }
      .app-card-tag { font-size: 12px; font-weight: 700; color: var(--accent); margin-bottom: 8px; letter-spacing: 0.02em; }
      .app-card h3 { font-size: 22px; font-weight: 700; color: var(--text-primary); margin-bottom: 12px; }
      .app-card h4 { font-size: 15px; font-weight: 600; color: var(--text-primary); margin: 20px 0 8px; }
      .app-card p, .app-card ul { font-size: 14px; color: var(--text-secondary); line-height: 1.75; margin-bottom: 12px; }
      .app-card ul { list-style: none; padding-left: 0; }
      .app-card ul li { position: relative; padding-left: 14px; margin-bottom: 6px; }
      .app-card ul li::before { content: "·"; position: absolute; left: 0; font-weight: 700; color: var(--accent); }
      .app-pill-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
      .app-pill { font-size: 13px; font-weight: 600; color: var(--accent); background: rgba(46, 134, 255, 0.1); border: 1px solid var(--border); padding: 8px 14px; border-radius: 20px; }
      .otp-flow { margin-top: 20px; }
      .otp-step { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 16px; padding: 14px 18px; background: rgba(46, 134, 255, 0.05); border: 1px solid var(--border); border-radius: 10px; }
      .otp-step-num { flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: #0f172a; font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
      .otp-step span { font-size: 14px; color: var(--text-secondary); line-height: 1.6; }
      .app-card-sub { font-size: 14px; color: var(--accent); font-weight: 600; margin-bottom: 8px; }
      .app-card.in-view { transition: border-color 0.2s ease, box-shadow 0.3s ease; }
      .app-card.in-view:hover { border-color: var(--accent-glow); box-shadow: 0 12px 32px rgba(0,0,0,0.08); }
      [data-theme="dark"] .app-card.in-view:hover { box-shadow: 0 12px 40px rgba(0,0,0,0.25), 0 0 0 1px rgba(46, 134, 255, 0.12); }

      /* ——— ROADMAP & VISION ——— */
      .roadmap-intro { font-size: 15px; color: var(--text-secondary); margin-bottom: 32px; max-width: 720px; line-height: 1.75; }
      .vision-strategy { margin-top: 24px; }
      .vision-strategy h3 { font-size: 17px; font-weight: 700; color: var(--accent); margin-bottom: 12px; }
      .vision-strategy ul { list-style: none; }
      .vision-strategy li { position: relative; padding-left: 18px; margin-bottom: 10px; font-size: 14px; color: var(--text-secondary); line-height: 1.7; }
      .vision-strategy li::before { content: ""; position: absolute; left: 0; top: 8px; width: 6px; height: 6px; background: var(--accent); border-radius: 50%; }
      .roadmap-block { margin-bottom: 40px; }
      .roadmap-block:last-of-type { margin-bottom: 0; }
      .roadmap-block h3 { font-size: 18px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; }
      .roadmap-block .block-tag { font-size: 12px; font-weight: 600; color: var(--accent); margin-bottom: 16px; }
      .roadmap-block p, .roadmap-block ul { font-size: 14px; color: var(--text-secondary); line-height: 1.75; margin-bottom: 12px; }
      .roadmap-block ul { list-style: none; padding-left: 0; }
      .roadmap-block ul li { position: relative; padding-left: 16px; margin-bottom: 8px; }
      .roadmap-block ul li::before { content: "–"; position: absolute; left: 0; color: var(--accent); }

      /* ——— 04. 글로벌 시장 확장 전략 (강화 UI) ——— */
      .global-strategy-wrap {
        margin-top: 48px;
        background: linear-gradient(180deg, var(--bg-off) 0%, rgba(46, 134, 255, 0.04) 100%);
        border: 1px solid var(--border);
        border-radius: 20px;
        overflow: hidden;
        transition: border-color 0.25s ease, box-shadow 0.35s ease;
      }
      .global-strategy-wrap:hover { border-color: var(--accent-glow); box-shadow: 0 20px 48px -16px rgba(46, 134, 255, 0.12); }
      .global-strategy-header {
        padding: 28px 32px 20px;
        border-bottom: 1px solid var(--border);
      }
      .global-strategy-title {
        font-size: 20px;
        font-weight: 800;
        color: var(--text-primary);
        margin-bottom: 8px;
        letter-spacing: -0.02em;
      }
      .global-strategy-subtitle {
        font-size: 14px;
        color: var(--accent);
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .global-strategy-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0;
      }
      @media (max-width: 700px) { .global-strategy-grid { grid-template-columns: 1fr; } }
      .global-strategy-item {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        border-right: 1px solid var(--border);
        transition: background 0.2s ease;
      }
      .global-strategy-grid .global-strategy-item:nth-child(2n) { border-right: none; }
      .global-strategy-grid .global-strategy-item:nth-last-child(-n+2) { border-bottom: none; }
      .global-strategy-grid .global-strategy-item:last-child { border-right: none; }
      @media (max-width: 700px) {
        .global-strategy-item { border-right: none; }
        .global-strategy-grid .global-strategy-item:nth-last-child(1) { border-bottom: none; }
      }
      .global-strategy-item:hover { background: rgba(46, 134, 255, 0.06); }
      .global-strategy-item-num {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg, rgba(46, 134, 255, 0.2), rgba(46, 134, 255, 0.08));
        border: 1px solid rgba(46, 134, 255, 0.25);
        color: var(--accent);
        font-size: 13px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .global-strategy-item-text {
        font-size: 15px;
        color: var(--text-secondary);
        line-height: 1.65;
      }
      .roadmap-card {
        background: var(--bg-off);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 26px 28px;
        margin-bottom: 20px;
        transition: border-color 0.25s ease, box-shadow 0.35s ease;
      }
      .roadmap-card:hover { border-color: rgba(46, 134, 255, 0.3); box-shadow: 0 12px 28px -8px rgba(46, 134, 255, 0.1); }
      .roadmap-card .block-tag { font-size: 11px; font-weight: 700; color: var(--accent); margin-bottom: 10px; letter-spacing: 0.05em; }
      .roadmap-card h4 { font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 14px; }
      .gov-chart-wrap {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 32px;
        margin-top: 24px;
      }
      .gov-chart-canvas-wrap {
        flex-shrink: 0;
        width: 220px;
        height: 220px;
        position: relative;
      }
      .gov-chart-canvas-wrap canvas { display: block; max-width: 100%; height: auto !important; }
      .gov-chart-legend {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 200px;
      }
      .gov-chart-legend-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
      }
      .gov-chart-legend-dot {
        width: 12px;
        height: 12px;
        border-radius: 4px;
        flex-shrink: 0;
      }
      .gov-chart-legend-item span:last-child { color: var(--text-secondary); }
      .gov-chart-legend-item strong { color: var(--accent); margin-left: 4px; }
      @media (max-width: 520px) {
        .gov-chart-wrap { flex-direction: column; }
        .gov-chart-canvas-wrap { width: 200px; height: 200px; }
      }
      .token-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 20px; }
      @media (max-width: 520px) { .token-grid { grid-template-columns: 1fr; } }
      .token-item { padding: 14px 18px; background: var(--bg-off); border: 1px solid var(--border); border-radius: 10px; display: flex; justify-content: space-between; align-items: center; font-size: 14px; }
      .token-item .name { color: var(--text-secondary); }
      .token-item .value { font-weight: 700; color: var(--text-primary); }
      .token-item .pct { font-size: 12px; font-weight: 600; color: var(--accent); margin-left: 8px; }

      /* ——— 실전 로드맵 타임라인 ——— */
      .roadmap-timeline-wrap { margin-top: 48px; margin-bottom: 56px; }
      .roadmap-timeline-title { font-size: 18px; font-weight: 700; color: var(--text-primary); margin-bottom: 32px; display: flex; align-items: center; gap: 10px; }
      .roadmap-timeline-title::before {
        content: "";
        width: 4px;
        height: 22px;
        background: linear-gradient(180deg, var(--accent), rgba(46, 134, 255, 0.4));
        border-radius: 2px;
      }
      .roadmap-timeline {
        position: relative;
        padding-left: 32px;
      }
      .roadmap-timeline::before {
        content: "";
        position: absolute;
        left: 10px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(180deg, var(--accent) 0%, rgba(46, 134, 255, 0.3) 50%, var(--border) 100%);
        border-radius: 1px;
      }
      .roadmap-milestone {
        position: relative;
        padding-bottom: 36px;
      }
      .roadmap-milestone:last-child { padding-bottom: 0; }
      .roadmap-milestone-dot {
        position: absolute;
        left: -28px;
        top: 4px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--bg-off);
        border: 3px solid var(--accent);
        box-shadow: 0 0 0 4px rgba(46, 134, 255, 0.15);
        z-index: 1;
      }
      .roadmap-milestone.milestone-done .roadmap-milestone-dot {
        background: var(--accent);
        box-shadow: 0 0 16px rgba(46, 134, 255, 0.5);
      }
      .roadmap-milestone.milestone-now .roadmap-milestone-dot {
        border-width: 3px;
        animation: pulse-dot 2s ease-in-out infinite;
      }
      @keyframes pulse-dot {
        0%, 100% { box-shadow: 0 0 0 4px rgba(46, 134, 255, 0.2); }
        50% { box-shadow: 0 0 0 10px rgba(46, 134, 255, 0.05); }
      }
      .roadmap-milestone-content {
        background: var(--bg-off);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 20px 24px;
        transition: border-color 0.2s ease, box-shadow 0.3s ease;
      }
      .roadmap-milestone-content:hover {
        border-color: var(--accent-glow);
        box-shadow: 0 12px 32px -8px rgba(0,0,0,0.12);
      }
      .roadmap-milestone-year {
        font-size: 13px;
        font-weight: 800;
        color: var(--accent);
        letter-spacing: 0.08em;
        margin-bottom: 8px;
      }
      .roadmap-milestone-label {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 10px;
        line-height: 1.35;
      }
      .roadmap-milestone-desc {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.7;
      }
      .roadmap-milestone-badge {
        display: inline-block;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--accent);
        background: rgba(46, 134, 255, 0.12);
        padding: 4px 10px;
        border-radius: 6px;
        margin-left: 10px;
        vertical-align: middle;
      }

      /* ——— Development History ——— */
      .dev-history-sub { font-size: 14px; color: var(--text-secondary); margin-bottom: 32px; max-width: 720px; line-height: 1.7; }
      .dev-history-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 32px;
        margin-top: 40px;
      }
      @media (max-width: 900px) {
        .dev-history-grid { grid-template-columns: 1fr; }
      }
      .dev-history-col {
        background: var(--bg-off);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 24px;
        position: relative;
      }
      .dev-history-col::before {
        content: "";
        position: absolute;
        left: 24px;
        top: 24px;
        bottom: 24px;
        width: 2px;
        background: linear-gradient(180deg, var(--accent), transparent);
        border-radius: 1px;
        opacity: 0.6;
      }
      .dev-history-col h3 {
        font-size: 18px;
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 20px;
        padding-left: 28px;
      }
      .dev-history-list { list-style: none; padding-left: 28px; }
      .dev-history-list li {
        position: relative;
        font-size: 13px;
        color: var(--text-secondary);
        line-height: 1.75;
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border);
      }
      .dev-history-list li:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
      .dev-history-list li::before {
        content: "";
        position: absolute;
        left: -20px;
        top: 8px;
        width: 6px;
        height: 6px;
        background: var(--accent);
        border-radius: 50%;
      }
      .dev-history-date {
        font-size: 11px;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 4px;
      }
      .dev-history-ko { display: block; }
      .dev-history-en { display: none; }
      html[lang="en"] .dev-history-ko { display: none; }
      html[lang="en"] .dev-history-en { display: block; }

      /* ——— 페이지 번역 (한글 원문 / 영어) ——— */
      .t-ko { display: inline; }
      .t-en { display: none; }
      html[lang="en"] .t-ko { display: none; }
      html[lang="en"] .t-en { display: inline; }
      .tb-ko { display: block; }
      .tb-en { display: none; }
      html[lang="en"] .tb-ko { display: none; }
      html[lang="en"] .tb-en { display: block; }

      /* ——— 특허 및 수상 ——— */
      .cert-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 32px;
      }
      @media (max-width: 900px) {
        .cert-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
      }
      .cert-item {
        background: var(--bg-off);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      }
      .cert-item:hover {
        border-color: var(--accent-glow);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      }
      .cert-item a {
        display: block;
        padding: 16px;
        text-decoration: none;
        color: inherit;
      }
      .cert-item img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 8px;
      }
      .cert-item .cert-caption {
        font-size: 12px;
        color: var(--text-secondary);
        margin-top: 12px;
        line-height: 1.5;
      }

      /* ——— 소개 영상 ——— */
      .intro-video-section {
        padding: 80px clamp(20px, 5vw, 40px) 60px;
        max-width: 1000px;
        margin: 0 auto;
      }
      .intro-video-section .section-title {
        margin-bottom: 24px;
      }
      .intro-video-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 220px;
        gap: 24px;
        align-items: start;
        max-width: 1000px;
        margin: 0 auto;
      }
      .intro-video-player {
        min-width: 0;
        width: 100%;
      }
      .intro-video-wrap {
        position: relative;
        width: 100%;
        max-width: 100%;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--border);
        background: var(--bg-off);
        box-shadow: 0 20px 48px -16px rgba(0, 0, 0, 0.2);
        line-height: 0;
      }
      .intro-video-wrap .tb-ko,
      .intro-video-wrap .tb-en {
        width: 100%;
      }
      .intro-video-wrap video {
        display: block;
        width: 100%;
        max-width: 100%;
        height: auto;
        vertical-align: top;
        object-fit: contain;
        background: #000;
      }
      [data-theme="light"] .intro-video-wrap {
        box-shadow: 0 20px 48px -16px rgba(0, 0, 0, 0.08);
      }
      .intro-video-tags {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-self: start;
      }
      .intro-video-tag {
        width: 100%;
        text-align: left;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.45;
        color: var(--text-secondary);
        background: var(--bg-off);
        border: 1px solid var(--border);
        padding: 12px 14px;
        border-radius: 12px;
        cursor: pointer;
        font-family: inherit;
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
      }
      .intro-video-tag:hover {
        color: var(--text-primary);
        border-color: rgba(46, 134, 255, 0.35);
      }
      .intro-video-tag.active {
        color: var(--accent);
        border-color: var(--accent);
        background: rgba(46, 134, 255, 0.1);
        box-shadow: 0 0 0 1px rgba(46, 134, 255, 0.15);
      }
      @media (max-width: 768px) {
        .intro-video-section { padding: 60px 20px 48px; }
        .intro-video-layout {
          grid-template-columns: 1fr;
          gap: 16px;
        }
        .intro-video-player { order: 1; }
        .intro-video-tags {
          order: 2;
          width: 100%;
          flex-direction: row;
          flex-wrap: wrap;
        }
        .intro-video-tag {
          flex: 1 1 calc(50% - 5px);
          min-width: 140px;
        }
      }

      /* ——— CTA + CONTACT (결론·문의 통합) ——— */
      .cta-contact-section {
        background: linear-gradient(180deg, var(--bg-off) 0%, var(--navy-mid) 100%);
        border-top: 1px solid var(--border);
        padding: 80px 24px 100px;
        max-width: none;
      }

      .cta-contact-inner {
        max-width: 900px;
        margin: 0 auto;
      }

      .cta-contact-head {
        text-align: center;
        margin-bottom: 40px;
      }

      .cta-contact-head .cta-title {
        font-size: clamp(26px, 4vw, 34px);
        font-weight: 800;
        color: var(--text-primary);
        letter-spacing: -0.03em;
        line-height: 1.3;
        margin-bottom: 16px;
      }

      .cta-contact-head .cta-sub {
        font-size: 17px;
        color: var(--text-secondary);
        line-height: 1.7;
        max-width: 640px;
        margin: 0 auto 20px;
      }

      .cta-contact-quote {
        display: inline-block;
        font-size: 18px;
        font-weight: 700;
        color: var(--accent);
        padding: 12px 20px;
        border: 1px solid rgba(46, 134, 255, 0.3);
        border-radius: 12px;
        background: rgba(46, 134, 255, 0.08);
      }

      .cta-contact-form-card {
        max-width: 520px;
        margin: 0 auto;
        padding: 36px 32px;
        background: var(--bg-white);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.25);
      }

      [data-theme="light"] .cta-contact-section {
        background: linear-gradient(180deg, #f1f5f9 0%, #e2e8f0 100%);
      }

      [data-theme="light"] .cta-contact-form-card {
        box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.08);
      }

      @media (max-width: 768px) {
        .cta-contact-section { padding: 60px 20px 80px; }
        .cta-contact-form-card { margin: 0 auto; padding: 28px 20px; }
        .paradigm-hero { padding: 60px 20px; }
        .paradigm-hero-inner { text-align: left; }
      }

      .cta-contact-form-card .form-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 8px;
      }

      .cta-contact-form-card .form-desc {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 24px;
      }

      .contact-section .section-subtitle {
        margin-bottom: 24px;
      }

      .contact-form {
        max-width: 100%;
        margin-top: 0;
      }
      .contact-form .form-group {
        margin-bottom: 18px;
      }
      .contact-form label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 6px;
      }
      .contact-form input,
      .contact-form textarea {
        width: 100%;
        padding: 12px 14px;
        font-size: 15px;
        font-family: inherit;
        color: var(--text-primary);
        background: var(--bg-off);
        border: 1px solid var(--border);
        border-radius: 8px;
        transition: border-color 0.2s;
      }
      .contact-form input::placeholder,
      .contact-form textarea::placeholder {
        color: var(--text-secondary);
        opacity: 0.8;
      }
      .contact-form input:focus,
      .contact-form textarea:focus {
        outline: none;
        border-color: var(--accent);
      }
      .contact-form textarea {
        min-height: 120px;
        resize: vertical;
      }
      .contact-form .btn-contact {
        margin-top: 8px;
      }
      .contact-form .form-message {
        font-size: 14px;
        margin-top: 12px;
        min-height: 20px;
      }
      .contact-form .form-message.success { color: var(--accent); }
      .contact-form .form-message.error { color: #f87171; }

      .contact-note {
        margin-top: 16px;
        font-size: 13px;
        color: var(--text-secondary);
      }

      /* CTA — minimal */
      .btn-contact {
        display: inline-block;
        margin-top: 24px;
        padding: 14px 28px;
        font-size: 15px;
        font-weight: 600;
        color: var(--navy);
        background: var(--accent);
        border: none;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease;
      }

      .btn-contact:hover {
        background: var(--accent-light);
        color: var(--navy);
      }

      .btn-contact:disabled {
        opacity: 0.7;
        cursor: not-allowed;
      }

      [data-theme="light"] .btn-contact {
        color: #fff;
        background: var(--accent);
      }
      [data-theme="light"] .btn-contact:hover {
        background: var(--accent-dark);
        color: #fff;
      }

      /* ——— Intersection Observer reveal animations ——— */
      .reveal {
        opacity: 0;
        transform: translateY(32px) scale(0.98);
        transition: opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1), transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .reveal.in-view {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      .reveal.reveal-scale {
        transform: translateY(24px) scale(0.96);
