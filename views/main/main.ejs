    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
      window.addEventListener("DOMContentLoaded", function() {
        // 입장 팝업 (세션당 1회, 7일 숨김 옵션)
        (function() {
          var popup = document.getElementById("sitePopup");
          if (!popup) return;

          var SESSION_KEY = "kquantum_popup_shown";
          var HIDE_UNTIL_KEY = "kquantum_popup_hide_until";
          var SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;

          function shouldShowPopup() {
            var hideUntil = localStorage.getItem(HIDE_UNTIL_KEY);
            if (hideUntil && Number(hideUntil) > Date.now()) return false;
            if (sessionStorage.getItem(SESSION_KEY)) return false;
            return true;
          }

          function markPopupShown() {
            sessionStorage.setItem(SESSION_KEY, "1");
          }

          function hidePopupFor7Days() {
            localStorage.setItem(HIDE_UNTIL_KEY, String(Date.now() + SEVEN_DAYS_MS));
            markPopupShown();
          }

          function openPopup() {
            popup.hidden = false;
            popup.classList.add("is-open");
            document.body.classList.add("site-popup-open");
            markPopupShown();
          }

          function closePopup() {
            popup.classList.remove("is-open");
            popup.hidden = true;
            document.body.classList.remove("site-popup-open");
          }

          popup.querySelectorAll("[data-popup-close]").forEach(function(el) {
            el.addEventListener("click", closePopup);
          });

          var hide7dBtn = document.getElementById("sitePopupHide7d");
          if (hide7dBtn) {
            hide7dBtn.addEventListener("click", function() {
              hidePopupFor7Days();
              closePopup();
            });
          }

          var popupLink = document.getElementById("sitePopupLink");
          if (popupLink) {
            popupLink.addEventListener("click", markPopupShown);
          }

          document.addEventListener("keydown", function(e) {
            if (e.key === "Escape" && popup.classList.contains("is-open")) closePopup();
          });

          if (shouldShowPopup()) openPopup();
        })();

        // Hash scroll: when opening /#section-id from another page, scroll to section
        var hash = window.location.hash;
        if (hash) {
          var el = document.querySelector(hash);
          if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
        }

        // Intersection Observer: trigger slightly before element enters view for smoother feel
        var revealObserver = new IntersectionObserver(
          function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
              }
            });
          },
          { threshold: 0.05, rootMargin: "0px 0px 80px 0px" }
        );

        document.querySelectorAll(".reveal").forEach(function(el) {
          if (!el.closest(".reveal-stagger")) revealObserver.observe(el);
        });

        var staggerObserver = new IntersectionObserver(
          function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                entry.target.querySelectorAll(".reveal").forEach(function(r) { r.classList.add("in-view"); });
              }
            });
          },
          { threshold: 0.05, rootMargin: "0px 0px 80px 0px" }
        );
        document.querySelectorAll(".reveal-stagger").forEach(function(c) { staggerObserver.observe(c); });

        // Hero: staggered entrance on load
        var hero = document.getElementById("hero");
        if (hero) {
          requestAnimationFrame(function() {
            hero.classList.add("in-view");
            var heroReveals = hero.querySelectorAll(".reveal");
            heroReveals.forEach(function(r, i) {
              r.style.transitionDelay = (i * 0.08) + "s";
            });
          });
        }

        // Governance doughnut chart (Chart.js)
        var govCanvas = document.getElementById("govChart");
        var govChartInstance = null;
        if (govCanvas && typeof Chart !== "undefined") {
          var govLabelsKo = ["퍼블릭 채굴", "초기 생태계 구축", "재단", "R&D", "마케팅", "ESG·사회복지 기금"];
          var govLabelsEn = ["Public mining", "Ecosystem", "Foundation", "R&D", "Marketing", "ESG & social fund"];
          govChartInstance = new Chart(govCanvas, {
            type: "doughnut",
            data: {
              labels: document.documentElement.getAttribute("lang") === "en" ? govLabelsEn : govLabelsKo,
              datasets: [{
                data: [80, 5, 5, 5, 4, 1],
                backgroundColor: ["#2E86FF", "#3399FF", "#1B6AFE", "#0056B3", "#004C99", "#003D7A"],
                borderWidth: 0,
                hoverOffset: 8
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: true,
              cutout: "58%",
              animation: { animateRotate: true, animateScale: true },
              plugins: {
                legend: { display: false },
                tooltip: {
                  callbacks: {
                    label: function(ctx) { return ctx.label + " " + ctx.raw + "%"; }
                  }
                }
              }
            }
          });
          var govLangObs = new MutationObserver(function() {
            if (govChartInstance && document.getElementById("govChart")) {
              govChartInstance.data.labels = document.documentElement.getAttribute("lang") === "en" ? govLabelsEn : govLabelsKo;
              govChartInstance.update();
            }
          });
          govLangObs.observe(document.documentElement, { attributes: true, attributeFilter: ["lang"] });
        }

        // Contact form: placeholders from data-placeholder-ko / data-placeholder-en
        function setContactPlaceholders() {
          var lang = document.documentElement.getAttribute("lang") === "en" ? "en" : "ko";
          var key = "data-placeholder-" + lang;
          document.querySelectorAll("#contactForm [data-placeholder-ko]").forEach(function(el) {
            var val = el.getAttribute(key);
            if (val) el.placeholder = val;
          });
        }
        setContactPlaceholders();
        // Intro video: tag switch (same file for KO / EN)
        (function() {
          var tags = document.querySelectorAll(".intro-video-tag");
          var videoKo = document.getElementById("introVideoKo");
          var videoEn = document.getElementById("introVideoEn");
          if (!tags.length || !videoKo || !videoEn) return;

          function encodeVideoSrc(path) {
            if (!path) return path;
            var parts = path.split("/");
            return parts.map(function(p, i) { return i === 0 ? p : encodeURIComponent(p); }).join("/");
          }

          function setVideoAriaLabels(tag) {
            var labelKo = tag.getAttribute("data-label-ko");
            var labelEn = tag.getAttribute("data-label-en");
            if (labelKo) videoKo.setAttribute("aria-label", labelKo);
            if (labelEn) videoEn.setAttribute("aria-label", labelEn);
          }

          function getTagSources(tag) {
            var srcKo = tag.getAttribute("data-src-ko") || tag.getAttribute("data-src");
            var srcEn = tag.getAttribute("data-src-en") || tag.getAttribute("data-src") || srcKo;
            return { ko: srcKo, en: srcEn };
          }

          function switchIntroVideo(tag) {
            var sources = getTagSources(tag);
            if (!sources.ko) return;

            tags.forEach(function(t) {
              t.classList.remove("active");
              t.setAttribute("aria-selected", "false");
            });
            tag.classList.add("active");
            tag.setAttribute("aria-selected", "true");

            videoKo.pause();
            videoEn.pause();
            videoKo.src = encodeVideoSrc(sources.ko);
            videoKo.load();
            videoEn.src = encodeVideoSrc(sources.en);
            videoEn.load();
            setVideoAriaLabels(tag);
          }

          tags.forEach(function(tag) {
            tag.addEventListener("click", function() {
              switchIntroVideo(tag);
            });
          });

          var activeTag = document.querySelector(".intro-video-tag.active");
          if (activeTag) {
            var initial = getTagSources(activeTag);
            videoKo.src = encodeVideoSrc(initial.ko);
            videoEn.src = encodeVideoSrc(initial.en);
            setVideoAriaLabels(activeTag);
          }

          window.updateIntroVideoAria = function() {
            var active = document.querySelector(".intro-video-tag.active");
            if (active) setVideoAriaLabels(active);
          };
        })();

        var langObs = new MutationObserver(function() {
          setContactPlaceholders();
          document.querySelectorAll(".intro-video-wrap video").forEach(function(v) { v.pause(); });
          if (typeof window.updateIntroVideoAria === "function") window.updateIntroVideoAria();
        });
        langObs.observe(document.documentElement, { attributes: true, attributeFilter: ["lang"] });

        // Contact form submit
        var contactForm = document.getElementById("contactForm");
        if (contactForm) {
          contactForm.addEventListener("submit", function(e) {
            e.preventDefault();
            var msgEl = document.getElementById("contactFormMessage");
            var btn = document.getElementById("contactSubmitBtn");
            var btnOriginalHtml = btn ? btn.innerHTML : "";
            var isEn = document.documentElement.getAttribute("lang") === "en";
            var name = document.getElementById("contactName").value.trim();
            var phone = document.getElementById("contactPhone").value.trim();
            var email = document.getElementById("contactEmail").value.trim();
            var message = document.getElementById("contactMessage").value.trim();
            if (!name || !phone || !email || !message) {
              if (msgEl) { msgEl.textContent = isEn ? "Please fill in all fields." : "모든 항목을 입력해 주세요."; msgEl.className = "form-message error"; }
              return;
            }
            if (btn) { btn.disabled = true; btn.innerHTML = isEn ? "Sending…" : "전송 중…"; }
            if (msgEl) { msgEl.textContent = ""; msgEl.className = "form-message"; }
            fetch("/api/contact", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ name: name, phone: phone, email: email, message: message })
            })
              .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
              .then(function(result) {
                if (result.ok && result.data && result.data.success) {
                  if (msgEl) { msgEl.textContent = isEn ? "Your inquiry has been submitted. We will contact you soon." : "문의가 접수되었습니다. 담당자가 연락드리겠습니다."; msgEl.className = "form-message success"; }
                  contactForm.reset();
                  setContactPlaceholders();
                } else {
                  if (msgEl) { msgEl.textContent = result.data && result.data.message ? result.data.message : (isEn ? "Submission failed. Please try again later." : "전송에 실패했습니다. 잠시 후 다시 시도해 주세요."); msgEl.className = "form-message error"; }
                }
              })
              .catch(function() {
                if (msgEl) { msgEl.textContent = isEn ? "Submission failed. Please try again later." : "전송에 실패했습니다. 잠시 후 다시 시도해 주세요."; msgEl.className = "form-message error"; }
              })
              .finally(function() {
                if (btn) {
                  btn.disabled = false;
                  btn.innerHTML = btnOriginalHtml;
                }
              });
          });
        }
      });
    </script>
