<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<meta name="robots" content="noindex, nofollow" />

<style>
  .admin-layout { display: flex; min-height: 100vh; }
  .admin-main { flex: 1; margin-left: var(--admin-sidebar-width, 280px); min-height: 100vh; min-width: 0; }
  .admin-sidebar {
    width: var(--admin-sidebar-width, 280px);
    background: #ffffff;
    border-right: 1px solid #e3f2fd;
    position: fixed; left: 0; top: 0; height: 100vh;
    overflow-y: auto; z-index: 1001;
    box-shadow: 2px 0 10px rgba(0,0,0,0.05);
  }
  .admin-sidebar-header {
    padding: 24px 20px;
    border-bottom: 1px solid #e3f2fd;
    text-align: center;
  }
  .admin-sidebar-logo { font-size: 18px; font-weight: 700; color: #1a237e; display: inline-flex; align-items: center; gap: 10px; }
  .admin-sidebar-logo img { width: 32px; height: 32px; object-fit: contain; display: block; }
  .admin-sidebar-panel-label { font-size: 11px; color: #90a4ae; margin-top: 4px; }
  .admin-sidebar-menu { padding: 20px 0; }
  .admin-sidebar-section { margin-bottom: 20px; }
  .admin-sidebar-section-title { padding: 0 20px 8px; font-size: 11px; font-weight: 600; color: #90a4ae; text-transform: uppercase; }
  .admin-sidebar-link {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 20px; color: #1a237e; text-decoration: none;
    transition: all 0.2s; font-size: 14px;
    border-left: 3px solid transparent;
  }
  .admin-sidebar-link:hover { background: rgba(46, 134, 255, 0.08); color: #007BFF; }
  .admin-sidebar-link.active { background: rgba(46, 134, 255, 0.12); color: #007BFF; border-left-color: #007BFF; font-weight: 600; }
  .admin-ko { display: inline; }
  .admin-en { display: none; }
  html[lang="en"] .admin-ko { display: none; }
  html[lang="en"] .admin-en { display: inline; }
  .admin-lang-switch {
    display: flex; align-items: center; justify-content: center; gap: 4px;
    margin-top: 12px; font-size: 12px;
  }
  .admin-lang-switch button {
    background: none; border: none; cursor: pointer; padding: 4px 10px;
    border-radius: 6px; color: #90a4ae; font-weight: 500;
  }
  .admin-lang-switch button:hover { color: #007BFF; }
  .admin-lang-switch button.active { color: #007BFF; font-weight: 600; }
  .admin-sidebar-link i { width: 20px; text-align: center; font-size: 16px; }
  .admin-sidebar-footer { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px; border-top: 1px solid #e3f2fd; background: #fff; }
  .admin-sidebar-logout {
    width: 100%; padding: 10px; background: transparent;
    border: 1px solid rgba(239,68,68,0.3); color: #ef4444;
    border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .admin-sidebar-logout:hover { background: rgba(239,68,68,0.1); }
  .admin-mobile-toggle {
    display: none; position: fixed; top: 16px; left: 16px; z-index: 1002;
    width: 40px; height: 40px; border: none; background: #fff;
    border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    align-items: center; justify-content: center; cursor: pointer;
  }
  .admin-sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
  .admin-sidebar-overlay.active { opacity: 1; pointer-events: auto; }
  @media (max-width: 1024px) {
    .admin-main { margin-left: 0; }
    .admin-sidebar { transform: translateX(-100%); transition: transform 0.3s; }
    .admin-sidebar.open { transform: translateX(0); box-shadow: 4px 0 20px rgba(0,0,0,0.15); }
    .admin-mobile-toggle { display: flex; }
  }
</style>

<div class="admin-sidebar-overlay" id="adminSidebarOverlay"></div>
<button type="button" class="admin-mobile-toggle" id="adminMobileToggle" aria-label="메뉴 열기"><i class="fas fa-bars"></i></button>

<aside class="admin-sidebar" id="adminSidebar">
  <div class="admin-sidebar-header">
    <a href="/admin/main" class="admin-sidebar-logo" style="text-decoration: none; color: inherit;"><img src="/images/logo.png" alt="K-Quantum" /><span class="admin-ko">K-Quantum 관리자</span><span class="admin-en">K-Quantum Admin</span></a>
    <div class="admin-sidebar-panel-label"><span class="admin-ko">관리자 패널</span><span class="admin-en">Admin Panel</span></div>
    <div class="admin-lang-switch">
      <button type="button" id="adminLangKo" aria-label="한국어">한글</button>
      <span style="opacity: 0.5;">|</span>
      <button type="button" id="adminLangEn" aria-label="English">EN</button>
    </div>
  </div>
  <nav class="admin-sidebar-menu">
    <div class="admin-sidebar-section">
      <div class="admin-sidebar-section-title"><span class="admin-ko">게시판</span><span class="admin-en">Board</span></div>
      <a href="/admin/boardList" class="admin-sidebar-link" data-path="/admin/boardList">
        <i class="fas fa-list"></i><span><span class="admin-ko">게시글 목록</span><span class="admin-en">Post List</span></span>
      </a>
      <a href="/admin/boardWrite" class="admin-sidebar-link" data-path="/admin/boardWrite">
        <i class="fas fa-pen"></i><span><span class="admin-ko">글 쓰기</span><span class="admin-en">Write Post</span></span>
      </a>
      <a href="/admin/boardCategories" class="admin-sidebar-link" data-path="/admin/boardCategories">
        <i class="fas fa-folder"></i><span><span class="admin-ko">카테고리 관리</span><span class="admin-en">Categories</span></span>
      </a>
      <a href="/admin/contactList" class="admin-sidebar-link" data-path="/admin/contactList">
        <i class="fas fa-envelope"></i><span><span class="admin-ko">문의 목록</span><span class="admin-en">Inquiries</span></span>
      </a>
    </div>
    <p class="admin-sidebar-data-hint" style="margin: 0 20px 16px; padding: 10px 12px; font-size: 11px; line-height: 1.45; color: #64748b; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
      <span class="admin-ko"><strong>저장 위치</strong><br />게시글·카테고리 → <code style="font-size:10px;">data/boardData.json</code><br />문의 접수 → <code style="font-size:10px;">data/appData.json</code> (contacts)</span>
      <span class="admin-en"><strong>Storage</strong><br />Posts &amp; categories → <code style="font-size:10px;">data/boardData.json</code><br />Inquiries → <code style="font-size:10px;">data/appData.json</code> (contacts)</span>
    </p>
  </nav>
  <div class="admin-sidebar-footer">
    <button type="button" class="admin-sidebar-logout" id="adminLogoutBtn"><i class="fas fa-sign-out-alt"></i> <span class="admin-ko">로그아웃</span><span class="admin-en">Log out</span></button>
  </div>
</aside>

<div class="modal fade" id="globalModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background: #fff; border: 1px solid #e2e8f0; border-radius: 16px;">
      <div class="modal-header" style="border-bottom: 1px solid #e2e8f0;">
        <h5 class="modal-title" id="globalModalTitle"><span class="admin-ko">알림</span><span class="admin-en">Notice</span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="globalModalBody" style="color: #1e293b;"></div>
      <div class="modal-footer" style="border-top: 1px solid #e2e8f0;">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" style="background: #007BFF; border: none;"><span class="admin-ko">확인</span><span class="admin-en">OK</span></button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    var lang = localStorage.getItem("kquantum-lang") === "en" ? "en" : "ko";
    document.documentElement.setAttribute("lang", lang);

    if (window.location.pathname !== "/admin/login" && localStorage.getItem("admin-needstrade-auth") !== "true") {
      window.location.href = "/admin/login";
      return;
    }
    window.showAdminModal = function(message, title) {
      var isEn = document.documentElement.getAttribute("lang") === "en";
      title = title || (isEn ? "Notice" : "알림");
      var elTitle = document.getElementById("globalModalTitle");
      var elBody = document.getElementById("globalModalBody");
      if (elTitle) elTitle.textContent = title;
      if (elBody) elBody.textContent = message;
      var modalEl = document.getElementById("globalModal");
      if (modalEl && typeof bootstrap !== "undefined") { var modal = new bootstrap.Modal(modalEl); modal.show(); }
    };
    var path = window.location.pathname;
    document.querySelectorAll(".admin-sidebar-link[data-path]").forEach(function(link) {
      var p = link.getAttribute("data-path");
      if (p && (path === p || path.indexOf(p + "/") === 0)) link.classList.add("active");
      else link.classList.remove("active");
    });
    if (path === "/admin/main") document.querySelector(".admin-sidebar-link[data-path='/admin/boardList']") && document.querySelector(".admin-sidebar-link[data-path='/admin/boardList']").classList.remove("active");
    var logoutBtn = document.getElementById("adminLogoutBtn");
    if (logoutBtn) logoutBtn.addEventListener("click", function(e) {
      e.preventDefault();
      var isEn = document.documentElement.getAttribute("lang") === "en";
      if (confirm(isEn ? "Log out?" : "로그아웃 하시겠습니까?")) { localStorage.removeItem("admin-needstrade-auth"); window.location.href = "/admin/login"; }
    });
    var overlay = document.getElementById("adminSidebarOverlay");
    if (overlay) overlay.addEventListener("click", function() {
      document.getElementById("adminSidebar").classList.remove("open");
      overlay.classList.remove("active");
    });
    document.getElementById("adminMobileToggle") && document.getElementById("adminMobileToggle").addEventListener("click", function() {
      var sb = document.getElementById("adminSidebar");
      var ov = document.getElementById("adminSidebarOverlay");
      sb.classList.toggle("open");
      ov.classList.toggle("active", sb.classList.contains("open"));
    });

    function setAdminLang(l) {
      document.documentElement.setAttribute("lang", l);
      localStorage.setItem("kquantum-lang", l);
      var koBtn = document.getElementById("adminLangKo");
      var enBtn = document.getElementById("adminLangEn");
      if (koBtn) koBtn.classList.toggle("active", l === "ko");
      if (enBtn) enBtn.classList.toggle("active", l === "en");
    }
    var koBtn = document.getElementById("adminLangKo");
    var enBtn = document.getElementById("adminLangEn");
    if (koBtn) koBtn.addEventListener("click", function() { setAdminLang("ko"); });
    if (enBtn) enBtn.addEventListener("click", function() { setAdminLang("en"); });
    if (koBtn) koBtn.classList.toggle("active", lang === "ko");
    if (enBtn) enBtn.classList.toggle("active", lang === "en");
  })();
</script>
